<?xml version="1.0" encoding="UTF-8"?> 
<!-- Fix: Capitalized Configuration -->
<Configuration status="WARN">
    <!-- Fix: Capitalized Appenders -->
    <Appenders>
        <!-- Console Appender -->
        <!-- Fix: Capitalized Console, PatternLayout -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </Console>

        <!-- General File Appender -->
        <!-- Fix: Capitalized File, ThresholdFilter, PatternLayout -->
        <File name="FileLogger" fileName="logs/app.log" append="true">
            <!-- Exclude ERROR and FATAL logs -->
            <ThresholdFilter level="ERROR" onMatch="DENY" onMismatch="ACCEPT" />
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </File>

        <!-- Error File Appender -->
        <File name="ErrorFileLogger" fileName="logs/error.log" append="true">
            <!-- Include only ERROR and FATAL logs -->
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY" />
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </File>
    </Appenders>

    <!-- Fix: Capitalized Loggers -->
    <Loggers>
        <!-- Logger for your explicit automation suite package -->
        <!-- Fix: Capitalized Logger, AppenderRef -->
        <Logger name="com.orangehrm" level="TRACE" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="FileLogger" />
            <AppenderRef ref="ErrorFileLogger" />
        </Logger>

        <!-- Root Logger: Captures framework-level logs (Selenium, TestNG) if they leak out -->
        <Root level="INFO">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>
